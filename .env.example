# ==============================================================================
# 旁白（PANGBAI）— 环境变量配置模板 (Supabase 云端数据库版)
# ==============================================================================

# 1. 应用运行环境标识 (development | production)
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# 2. Supabase 云端 PostgreSQL 数据库配置 (核心必填)
# 获取路径: Supabase Console -> Project Settings -> Database -> Connection String
# ------------------------------------------------------------------------------
# DATABASE_URL: 连接池模式连接串 (推荐用于生产与 Serverless，端口 6543，带有 pgbouncer/pooler)
# 格式: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# DIRECT_URL: 直连模式连接串 (用于 drizzle-kit migration / push，端口 5432)
# 格式: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# 3. Supabase API 与认证配置 (选填，后续启用 Supabase Auth / Storage 时生效)
# 获取路径: Supabase Console -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. 大模型推理服务配置 (SiliconFlow / DeepSeek-V3)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEFAULT_MODEL=deepseek-ai/DeepSeek-V3

# 5. 调试与日志开关
DEBUG_LOGGING=false

# 6. 单用户生产访问保护（生产环境必填；开发环境可留空）
PANGBAI_AUTH_USER=your_admin_username
PANGBAI_AUTH_PASSWORD=use_a_long_random_password

# 7. 飞书服务端集成（按需启用）
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
LARK_CLI_BIN=lark-cli
